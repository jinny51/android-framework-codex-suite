{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:worker-assignment:v1",
  "title": "Android change workflow worker assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assignment_id",
    "run_id",
    "attempt",
    "issued_at",
    "source_snapshot_sha256",
    "controller",
    "assignee",
    "effect",
    "objective",
    "input_bindings",
    "scope",
    "constraints",
    "permissions",
    "required_evidence",
    "result_schema"
  ],
  "properties": {
    "schema": {"const": "worker-assignment-v1"},
    "assignment_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "attempt": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "controller": {"const": "android-change-workflow"},
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_source", "worker_profile_id"],
      "properties": {
        "profile_source": {"enum": ["core", "provider"]},
        "worker_profile_id": {"$ref": "#/$defs/id"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "provider_manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"profile_source": {"const": "provider"}}},
          "then": {"required": ["provider_id", "provider_version", "provider_manifest_sha256"]},
          "else": {"not": {"anyOf": [{"required": ["provider_id"]}, {"required": ["provider_version"]}, {"required": ["provider_manifest_sha256"]}]}}
        }
      ]
    },
    "effect": {"enum": ["read_only", "workspace_mutation", "controlled_operation"]},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "input_bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*_sha256$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "paths"],
      "properties": {
        "repositories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pathScope"}}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_automatic_escalations", "environment_failure_escalates_model"],
      "properties": {
        "max_automatic_escalations": {"const": 1},
        "environment_failure_escalates_model": {"const": false},
        "authority_ref": {"type": "string", "minLength": 1},
        "workspace_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workspaceBinding"}},
        "controlled_operation": {"$ref": "#/$defs/controlledOperation"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_acquire_authority", "may_expand_scope", "may_upload", "may_accept_gate", "may_final_accept"],
      "properties": {
        "may_acquire_authority": {"const": false},
        "may_expand_scope": {"const": false},
        "may_upload": {"const": false},
        "may_accept_gate": {"const": false},
        "may_final_accept": {"const": false}
      }
    },
    "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result_schema": {"const": "worker-result-v1"}
  },
  "allOf": [
    {
      "if": {"properties": {"effect": {"const": "read_only"}}},
      "then": {
        "properties": {
          "constraints": {
            "not": {"anyOf": [{"required": ["authority_ref"]}, {"required": ["controlled_operation"]}]}
          }
        }
      }
    },
    {
      "if": {"properties": {"effect": {"const": "workspace_mutation"}}},
      "then": {
        "properties": {
          "constraints": {"required": ["authority_ref", "workspace_bindings"]}
        }
      }
    },
    {
      "if": {"properties": {"effect": {"const": "controlled_operation"}}},
      "then": {
        "properties": {
          "constraints": {"required": ["authority_ref", "controlled_operation"]}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pathScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "kind", "path"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["file", "tree"]},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.git(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
      }
    },
    "workspaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "workspace_id", "base_revision", "target_expected_head", "paths", "authority_ref"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/id"},
        "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "target_expected_head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pathScope"}},
        "authority_ref": {"type": "string", "minLength": 1}
      }
    },
    "controlledOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "profile_id", "command_id", "artifact_sha256", "device_id", "rollback_id"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/id"},
        "profile_id": {"$ref": "#/$defs/id"},
        "command_id": {"$ref": "#/$defs/id"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "device_id": {"$ref": "#/$defs/id"},
        "rollback_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
