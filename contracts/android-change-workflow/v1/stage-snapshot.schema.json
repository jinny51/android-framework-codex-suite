{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:stage-snapshot:v1",
  "title": "Android change workflow stage snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "run_id",
    "sequence",
    "created_at",
    "snapshot_reason",
    "controller",
    "stage",
    "input_bindings",
    "provider_resolution",
    "workspace_bindings",
    "event"
  ],
  "properties": {
    "schema": {"const": "stage-snapshot-v1"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "previous_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_reason": {"enum": ["delegating_worker", "entering_high_risk_mutation", "gate_transition", "pause_resume", "cross_session_handoff"]},
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority"],
      "properties": {
        "id": {"const": "android-change-workflow"},
        "authority": {"const": "stage_gate_and_requirement_acceptance"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "gate_index", "state", "risk_level"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "gate_index": {"type": "integer", "minimum": 0},
        "state": {"enum": ["active", "paused", "blocked", "completed"]},
        "risk_level": {"enum": ["low", "medium", "high"]}
      }
    },
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_sha256", "core_policy_sha256", "extension_config_sha256"],
      "properties": {
        "requirement_sha256": {"$ref": "#/$defs/sha256"},
        "core_policy_sha256": {"$ref": "#/$defs/sha256"},
        "extension_config_sha256": {"$ref": "#/$defs/sha256"},
        "coding_decision_sha256": {"$ref": "#/$defs/sha256"},
        "execution_decision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provider_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_mode", "coding", "execution"],
      "properties": {
        "selection_mode": {"enum": ["none", "jinny", "custom"]},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "provider_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "coding": {"$ref": "#/$defs/capabilityResolution"},
        "execution": {"$ref": "#/$defs/capabilityResolution"}
      },
      "allOf": [
        {
          "if": {"properties": {"selection_mode": {"const": "none"}}},
          "then": {
            "not": {"anyOf": [{"required": ["provider_id"]}, {"required": ["provider_version"]}, {"required": ["provider_manifest_sha256"]}]},
            "properties": {
              "coding": {"properties": {"source": {"const": "core"}, "reason": {"const": "mode_none"}}},
              "execution": {"properties": {"source": {"const": "core"}, "reason": {"const": "mode_none"}}}
            }
          },
          "else": {"required": ["provider_id", "provider_version", "provider_manifest_sha256"]}
        }
      ]
    },
    "workspace_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/workspaceBinding"}
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["snapshot", "assignment_planned", "mutation_authority_bound", "gate_changed", "paused", "resumed", "handoff"]},
        "planned_assignment_id": {"$ref": "#/$defs/id"},
        "worker_result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "last_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "result_sha256", "controller_validation"],
      "properties": {
        "assignment_id": {"$ref": "#/$defs/id"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "controller_validation": {"enum": ["valid", "invalid", "pending"]}
      }
    },
    "requirement_disposition": {"enum": ["accepted", "rejected", "blocked"]}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"minimum": 2}}},
      "then": {"required": ["previous_snapshot_sha256"]},
      "else": {"not": {"required": ["previous_snapshot_sha256"]}}
    },
    {
      "if": {"properties": {"snapshot_reason": {"const": "delegating_worker"}}},
      "then": {
        "properties": {
          "event": {
            "properties": {"type": {"const": "assignment_planned"}},
            "required": ["planned_assignment_id"]
          }
        }
      }
    },
    {
      "if": {"properties": {"snapshot_reason": {"const": "gate_transition"}}},
      "then": {
        "properties": {
          "event": {"properties": {"type": {"const": "gate_changed"}}}
        }
      }
    },
    {
      "if": {"properties": {"snapshot_reason": {"const": "entering_high_risk_mutation"}}},
      "then": {
        "properties": {
          "stage": {"properties": {"risk_level": {"const": "high"}}},
          "workspace_bindings": {"minItems": 1},
          "event": {"properties": {"type": {"const": "mutation_authority_bound"}}}
        }
      }
    },
    {
      "if": {"properties": {"snapshot_reason": {"const": "cross_session_handoff"}}},
      "then": {"properties": {"event": {"properties": {"type": {"const": "handoff"}}}}}
    },
    {
      "if": {"properties": {"snapshot_reason": {"const": "pause_resume"}}},
      "then": {
        "properties": {
          "event": {"properties": {"type": {"enum": ["paused", "resumed"]}}}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilityResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": {
        "source": {"enum": ["core", "provider"]},
        "reason": {"enum": ["mode_none", "provider_capability", "capability_absent", "applicability_miss"]}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "provider"}}},
          "then": {"properties": {"reason": {"const": "provider_capability"}}},
          "else": {"properties": {"reason": {"enum": ["mode_none", "capability_absent", "applicability_miss"]}}}
        }
      ]
    },
    "workspaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "source_authority", "workspace_id", "base_revision", "target_expected_head", "scope", "authority_ref"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/id"},
        "source_authority": {"type": "string", "minLength": 1},
        "workspace_id": {"$ref": "#/$defs/id"},
        "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "target_expected_head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
