{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:coding-policy-decision:v1",
  "title": "Coding policy decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "run_id",
    "stage_id",
    "context_sha256",
    "core_policy_sha256",
    "provider",
    "outcome",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "coding-policy-decision-v1"},
    "decision_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "stage_id": {"$ref": "#/$defs/id"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "core_policy_sha256": {"$ref": "#/$defs/sha256"},
    "provider": {"$ref": "#/$defs/providerBinding"},
    "outcome": {
      "oneOf": [
        {"$ref": "#/$defs/appliedOutcome"},
        {"$ref": "#/$defs/blockedOutcome"}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "layer": {"enum": ["application", "platform", "native", "hal", "kernel", "device", "build"]},
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_version", "provider_manifest_sha256", "skill_id", "skill_version"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-android-practices$"},
        "provider_version": {"$ref": "#/$defs/semver"},
        "provider_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "skill_version": {"$ref": "#/$defs/semver"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_layers", "path_patterns", "languages"],
      "properties": {
        "component_layers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/layer"}},
        "path_patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "effect", "statement", "scope", "evidence_requirements"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "effect": {"enum": ["require", "forbid", "recommend"]},
        "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "scope": {"$ref": "#/$defs/scope"},
        "evidence_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "appliedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rules"],
      "properties": {
        "type": {"const": "applied"},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "blockedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason_codes"],
      "properties": {
        "type": {"const": "blocked"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
