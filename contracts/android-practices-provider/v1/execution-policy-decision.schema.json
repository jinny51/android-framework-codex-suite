{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:execution-policy-decision:v1",
  "title": "Execution policy decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "run_id",
    "stage_id",
    "context_sha256",
    "provider",
    "outcome",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "execution-policy-decision-v1"},
    "decision_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "stage_id": {"$ref": "#/$defs/id"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "provider": {"$ref": "#/$defs/providerBinding"},
    "outcome": {
      "oneOf": [
        {"$ref": "#/$defs/coreDirectOutcome"},
        {"$ref": "#/$defs/delegateOutcome"},
        {"$ref": "#/$defs/blockedOutcome"}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_version", "provider_manifest_sha256", "skill_id", "skill_version"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-android-practices$"},
        "provider_version": {"$ref": "#/$defs/semver"},
        "provider_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "skill_version": {"$ref": "#/$defs/semver"}
      }
    },
    "coreDirectOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason_codes"],
      "properties": {
        "type": {"const": "core_direct"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "delegateOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "worker_profile_id",
        "task_class",
        "requested_effect",
        "reason_codes",
        "independent_review_requested"
      ],
      "properties": {
        "type": {"const": "delegate"},
        "worker_profile_id": {"$ref": "#/$defs/id"},
        "task_class": {"enum": ["analysis", "diagnosis", "implementation", "review", "verification", "bounded_operation"]},
        "requested_effect": {"enum": ["read_only", "workspace_mutation", "controlled_operation"]},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "independent_review_requested": {"type": "boolean"},
        "escalation_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger", "worker_profile_id"],
          "properties": {
            "trigger": {"enum": ["requires_code_judgment", "requires_architecture_or_high_risk"]},
            "worker_profile_id": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "blockedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason_codes"],
      "properties": {
        "type": {"const": "blocked"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
