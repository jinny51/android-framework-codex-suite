{
  "schema": "akbs-component-evidence-profiles-v1",
  "applies_to_schema": "akbs-android-change-package-v2",
  "evaluation_scope": "per_component",
  "all_components_must_qualify": true,
  "accepted_claim_source": "contract_adapter_output_only",
  "common_required_groups": [
    "source_integrity",
    "change_diff_facts",
    "risk_surface",
    "android_change_policy",
    "feature_acceptance",
    "regression",
    "rollback"
  ],
  "workflow_requirements": {
    "current_codex_skill": [
      "pre_change_search"
    ],
    "manual_import": [
      "hash_bound_import_provenance"
    ],
    "historical_import": [
      "hash_bound_import_provenance"
    ]
  },
  "not_applicable": {
    "allowed_only_when_group_declares_optional": true,
    "requires": [
      "basis",
      "limits"
    ],
    "never_satisfies": [
      "source_integrity",
      "feature_acceptance"
    ]
  },
  "evidence_group_registry": {
    "schema": "akbs-evidence-group-registry-v1",
    "adapter_output_schema": "akbs-accepted-evidence-claim-v1",
    "required_adapter_binding_fields": [
      "adapter_contract",
      "adapter_version",
      "source_evidence_sha256",
      "accepted_claim",
      "accepted_result"
    ],
    "groups": {
      "source_integrity": {"adapter_contract": "akbs-source-integrity-adapter", "adapter_version": "1", "accepted_claim": "source_integrity", "accepted_results": ["PASS"], "not_applicable": false},
      "change_diff_facts": {"adapter_contract": "akbs-change-diff-adapter", "adapter_version": "1", "accepted_claim": "change_diff_facts", "accepted_results": ["PASS", "INFO"], "not_applicable": false},
      "risk_surface": {"adapter_contract": "akbs-risk-surface-adapter", "adapter_version": "1", "accepted_claim": "risk_surface", "accepted_results": ["PASS", "INFO"], "not_applicable": false},
      "android_change_policy": {"adapter_contract": "akbs-android-change-policy-adapter", "adapter_version": "1", "accepted_claim": "android_change_policy", "accepted_results": ["PASS"], "not_applicable": false},
      "feature_acceptance": {"adapter_contract": "akbs-feature-acceptance-adapter", "adapter_version": "1", "accepted_claim": "feature_acceptance", "accepted_results": ["PASS"], "not_applicable": false},
      "regression": {"adapter_contract": "akbs-regression-adapter", "adapter_version": "1", "accepted_claim": "regression", "accepted_results": ["PASS"], "not_applicable": false},
      "rollback": {"adapter_contract": "akbs-rollback-adapter", "adapter_version": "1", "accepted_claim": "rollback", "accepted_results": ["PASS"], "not_applicable": false},
      "pre_change_search": {"adapter_contract": "akbs-pre-change-search-adapter", "adapter_version": "1", "accepted_claim": "pre_change_search", "accepted_results": ["PASS", "INFO"], "not_applicable": false},
      "hash_bound_import_provenance": {"adapter_contract": "akbs-import-provenance-adapter", "adapter_version": "1", "accepted_claim": "hash_bound_import_provenance", "accepted_results": ["PASS"], "not_applicable": false},
      "application_build": {"adapter_contract": "akbs-application-build-adapter", "adapter_version": "1", "accepted_claim": "application_build", "accepted_results": ["PASS"], "not_applicable": false},
      "application_runtime_or_integration": {"adapter_contract": "akbs-application-runtime-adapter", "adapter_version": "1", "accepted_claim": "application_runtime_or_integration", "accepted_results": ["PASS"], "not_applicable": false},
      "permission_and_signing": {"adapter_contract": "akbs-permission-signing-adapter", "adapter_version": "1", "accepted_claim": "permission_and_signing", "accepted_results": ["PASS", "NOT_APPLICABLE"], "not_applicable": true},
      "install_or_upgrade": {"adapter_contract": "akbs-install-upgrade-adapter", "adapter_version": "1", "accepted_claim": "install_or_upgrade", "accepted_results": ["PASS", "NOT_APPLICABLE"], "not_applicable": true},
      "platform_build": {"adapter_contract": "akbs-platform-build-adapter", "adapter_version": "1", "accepted_claim": "platform_build", "accepted_results": ["PASS"], "not_applicable": false},
      "platform_runtime": {"adapter_contract": "akbs-platform-runtime-adapter", "adapter_version": "1", "accepted_claim": "platform_runtime", "accepted_results": ["PASS"], "not_applicable": false},
      "api_or_resource_compatibility": {"adapter_contract": "akbs-platform-compatibility-adapter", "adapter_version": "1", "accepted_claim": "api_or_resource_compatibility", "accepted_results": ["PASS", "NOT_APPLICABLE"], "not_applicable": true},
      "native_build": {"adapter_contract": "akbs-native-build-adapter", "adapter_version": "1", "accepted_claim": "native_build", "accepted_results": ["PASS"], "not_applicable": false},
      "native_runtime": {"adapter_contract": "akbs-native-runtime-adapter", "adapter_version": "1", "accepted_claim": "native_runtime", "accepted_results": ["PASS"], "not_applicable": false},
      "abi_api_or_linker_compatibility": {"adapter_contract": "akbs-native-compatibility-adapter", "adapter_version": "1", "accepted_claim": "abi_api_or_linker_compatibility", "accepted_results": ["PASS", "NOT_APPLICABLE"], "not_applicable": true},
      "hal_build": {"adapter_contract": "akbs-hal-build-adapter", "adapter_version": "1", "accepted_claim": "hal_build", "accepted_results": ["PASS"], "not_applicable": false},
      "interface_version": {"adapter_contract": "akbs-hal-interface-adapter", "adapter_version": "1", "accepted_claim": "interface_version", "accepted_results": ["PASS"], "not_applicable": false},
      "vintf_selinux_service_registration": {"adapter_contract": "akbs-hal-integration-adapter", "adapter_version": "1", "accepted_claim": "vintf_selinux_service_registration", "accepted_results": ["PASS"], "not_applicable": false},
      "hardware_behavior": {"adapter_contract": "akbs-hardware-behavior-adapter", "adapter_version": "1", "accepted_claim": "hardware_behavior", "accepted_results": ["PASS"], "not_applicable": false},
      "kernel_or_module_build": {"adapter_contract": "akbs-kernel-build-adapter", "adapter_version": "1", "accepted_claim": "kernel_or_module_build", "accepted_results": ["PASS"], "not_applicable": false},
      "kconfig_and_build_graph": {"adapter_contract": "akbs-kconfig-build-graph-adapter", "adapter_version": "1", "accepted_claim": "kconfig_and_build_graph", "accepted_results": ["PASS"], "not_applicable": false},
      "boot": {"adapter_contract": "akbs-boot-adapter", "adapter_version": "1", "accepted_claim": "boot", "accepted_results": ["PASS"], "not_applicable": false},
      "probe_bind_or_dmesg": {"adapter_contract": "akbs-kernel-runtime-adapter", "adapter_version": "1", "accepted_claim": "probe_bind_or_dmesg", "accepted_results": ["PASS"], "not_applicable": false},
      "power_and_suspend_resume": {"adapter_contract": "akbs-power-suspend-adapter", "adapter_version": "1", "accepted_claim": "power_and_suspend_resume", "accepted_results": ["PASS", "NOT_APPLICABLE"], "not_applicable": true},
      "board_build": {"adapter_contract": "akbs-board-build-adapter", "adapter_version": "1", "accepted_claim": "board_build", "accepted_results": ["PASS"], "not_applicable": false},
      "boot_integration": {"adapter_contract": "akbs-boot-integration-adapter", "adapter_version": "1", "accepted_claim": "boot_integration", "accepted_results": ["PASS"], "not_applicable": false},
      "partition_overlay_or_policy": {"adapter_contract": "akbs-device-policy-adapter", "adapter_version": "1", "accepted_claim": "partition_overlay_or_policy", "accepted_results": ["PASS"], "not_applicable": false},
      "device_behavior": {"adapter_contract": "akbs-device-behavior-adapter", "adapter_version": "1", "accepted_claim": "device_behavior", "accepted_results": ["PASS"], "not_applicable": false},
      "dependency_graph": {"adapter_contract": "akbs-build-graph-adapter", "adapter_version": "1", "accepted_claim": "dependency_graph", "accepted_results": ["PASS"], "not_applicable": false},
      "build_result": {"adapter_contract": "akbs-build-result-adapter", "adapter_version": "1", "accepted_claim": "build_result", "accepted_results": ["PASS"], "not_applicable": false},
      "clean_and_incremental": {"adapter_contract": "akbs-build-mode-adapter", "adapter_version": "1", "accepted_claim": "clean_and_incremental", "accepted_results": ["PASS"], "not_applicable": false},
      "artifact_contract": {"adapter_contract": "akbs-artifact-contract-adapter", "adapter_version": "1", "accepted_claim": "artifact_contract", "accepted_results": ["PASS"], "not_applicable": false},
      "reproducibility": {"adapter_contract": "akbs-reproducibility-adapter", "adapter_version": "1", "accepted_claim": "reproducibility", "accepted_results": ["PASS", "NOT_APPLICABLE"], "not_applicable": true}
    }
  },
  "accepted_evidence_claim_contract": {
    "schema": "akbs-accepted-evidence-claim-v1",
    "required_fields": [
      "schema",
      "component_id",
      "group_id",
      "source_evidence_id",
      "source_evidence_sha256",
      "adapter_contract",
      "adapter_version",
      "accepted_claim",
      "accepted_result"
    ],
    "additional_fields": [
      "not_applicable_basis"
    ],
    "additional_properties": false,
    "hash_binding": "external_file_sha256"
  },
  "conditional_predicates": {
    "application.system_or_privileged": {"type_in": ["system_app", "privileged_app"]},
    "application.installable": {"qualifier_contains": "installable"},
    "platform.api_or_resource_surface": {"type_in": ["framework_api", "framework_resource"]},
    "native.published_abi_or_api": {"qualifier_contains": "published_abi_or_api"},
    "hal.runtime_or_hardware_change": {"always": true},
    "kernel.driver_or_hardware_change": {"type_in": ["driver", "kernel_module", "firmware_interface"]},
    "kernel.power_managed_device": {"qualifier_contains": "power_managed"},
    "build.reproducibility_relevant": {"qualifier_contains": "reproducibility_relevant"}
  },
  "layers": {
    "application": {
      "recommended_types": [
        "system_app",
        "privileged_app",
        "app",
        "service_app"
      ],
      "typical_partitions": [
        "system",
        "system_ext",
        "product",
        "vendor",
        "data"
      ],
      "typical_ownership": [
        "aosp",
        "vendor",
        "product",
        "third_party"
      ],
      "required_groups": [
        "application_build",
        "application_runtime_or_integration"
      ],
      "conditional_groups": {
        "system_or_privileged": [
          "permission_and_signing"
        ],
        "installable": [
          "install_or_upgrade"
        ]
      }
    },
    "platform": {
      "recommended_types": [
        "framework",
        "framework_service",
        "framework_api",
        "framework_resource",
        "runtime"
      ],
      "typical_partitions": [
        "system",
        "system_ext",
        "product"
      ],
      "typical_ownership": [
        "aosp",
        "vendor",
        "product"
      ],
      "required_groups": [
        "platform_build",
        "platform_runtime"
      ],
      "conditional_groups": {
        "api_or_resource_surface": [
          "api_or_resource_compatibility"
        ]
      }
    },
    "native": {
      "recommended_types": [
        "native_service",
        "native_library",
        "daemon",
        "cli"
      ],
      "typical_partitions": [
        "system",
        "system_ext",
        "product",
        "vendor",
        "odm"
      ],
      "typical_ownership": [
        "aosp",
        "vendor",
        "product",
        "third_party"
      ],
      "required_groups": [
        "native_build",
        "native_runtime"
      ],
      "conditional_groups": {
        "published_abi_or_api": [
          "abi_api_or_linker_compatibility"
        ]
      }
    },
    "hal": {
      "recommended_types": [
        "aidl_hal",
        "hidl_hal",
        "legacy_hal",
        "hal_service"
      ],
      "typical_partitions": [
        "vendor",
        "odm",
        "system"
      ],
      "typical_ownership": [
        "aosp",
        "vendor",
        "silicon_vendor"
      ],
      "required_groups": [
        "hal_build",
        "interface_version",
        "vintf_selinux_service_registration"
      ],
      "conditional_groups": {
        "runtime_or_hardware_change": [
          "hardware_behavior"
        ]
      },
      "static_review_only_is_insufficient_for_hardware_behavior": true
    },
    "kernel": {
      "recommended_types": [
        "kernel_core",
        "driver",
        "kernel_module",
        "firmware_interface"
      ],
      "typical_partitions": [
        "boot",
        "vendor_boot",
        "vendor_dlkm",
        "odm_dlkm"
      ],
      "typical_ownership": [
        "upstream",
        "android_common",
        "silicon_vendor",
        "vendor"
      ],
      "required_groups": [
        "kernel_or_module_build",
        "kconfig_and_build_graph",
        "boot",
        "probe_bind_or_dmesg"
      ],
      "conditional_groups": {
        "driver_or_hardware_change": [
          "hardware_behavior"
        ],
        "power_managed_device": [
          "power_and_suspend_resume"
        ]
      },
      "static_review_only_is_insufficient_for_hardware_behavior": true
    },
    "device": {
      "recommended_types": [
        "board_config",
        "device_tree",
        "product_config",
        "overlay",
        "sepolicy",
        "init",
        "fstab"
      ],
      "typical_partitions": [
        "boot",
        "vendor_boot",
        "system",
        "system_ext",
        "product",
        "vendor",
        "odm"
      ],
      "typical_ownership": [
        "aosp",
        "product",
        "vendor",
        "silicon_vendor"
      ],
      "required_groups": [
        "board_build",
        "boot_integration",
        "partition_overlay_or_policy",
        "device_behavior"
      ],
      "conditional_groups": {}
    },
    "build": {
      "recommended_types": [
        "soong",
        "make",
        "gradle",
        "toolchain",
        "release"
      ],
      "typical_partitions": [
        "build_host",
        "all"
      ],
      "typical_ownership": [
        "aosp",
        "product",
        "vendor",
        "third_party"
      ],
      "required_groups": [
        "dependency_graph",
        "build_result",
        "clean_and_incremental",
        "artifact_contract"
      ],
      "conditional_groups": {
        "reproducibility_relevant": [
          "reproducibility"
        ]
      }
    }
  },
  "semantic_rules": [
    "component_ids_file_ids_source_ids_and_evidence_ids_are_unique",
    "all_references_resolve_and_match_their_declared_role",
    "primary_component_exists",
    "every_component_has_change_and_qualification_bindings",
    "archive_contains_exactly_manifest_and_declared_files",
    "manifest_does_not_hash_itself",
    "every_declared_file_size_and_sha256_matches",
    "component_classification_uses_source_and_change_facts_not_title_only",
    "declared_claims_are_untrusted_until_contract_adapter_acceptance",
    "all_component_profiles_are_intersected_for_package_validation",
    "build_delivery_does_not_imply_feature_acceptance"
  ],
  "submission_boundary": {
    "manifest_excludes": [
      "patch_package_id",
      "idempotency_key",
      "server_receipt",
      "authenticated_actor",
      "manifest_sha256",
      "directory_payload_sha256"
    ],
    "submit_envelope_owns": [
      "authenticated_actor",
      "idempotency_key",
      "manifest_sha256",
      "directory_payload_sha256"
    ],
    "server_owns": [
      "patch_package_id",
      "queue_state",
      "receipt"
    ]
  },
  "legacy_v1": {
    "schema": "knowledge-incoming-package",
    "schema_version": "1",
    "package_kind": "framework_change",
    "read_compatibility": "permanent",
    "projection": {
      "layer": "platform",
      "type": "framework",
      "partition": null,
      "ownership": null
    },
    "normalized_read_projection": {
      "schema": "akbs-normalized-component-read-v1",
      "component_fields": {
        "layer": {"required": true, "nullable": false},
        "type": {"required": true, "nullable": false},
        "partition": {"required": true, "nullable": true},
        "ownership": {"required": true, "nullable": true}
      },
      "preserve_verbatim": [
        "package_identity",
        "git_url",
        "commit",
        "receipt",
        "hash",
        "provenance"
      ],
      "write_back": false
    },
    "history_rewrite": false
  }
}
