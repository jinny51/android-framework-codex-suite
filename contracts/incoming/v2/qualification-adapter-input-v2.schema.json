{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:qualification-adapter-input:v2",
  "title": "AKBS qualification adapter input v2",
  "$ref": "#/$defs/adapterInput",
  "$defs": {
    "adapterInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_version",
        "group_id",
        "component",
        "workflow_contract",
        "capture_binding",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "akbs-qualification-adapter-input-v2"
        },
        "contract_version": {
          "const": "2"
        },
        "group_id": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "workflow_contract": {
          "enum": [
            "current_codex_skill",
            "manual_import",
            "historical_import"
          ]
        },
        "capture_binding": {
          "$ref": "#/$defs/captureBinding"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "type",
        "partition",
        "ownership"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "layer": {
          "enum": [
            "application",
            "platform",
            "native",
            "hal",
            "kernel",
            "device",
            "build"
          ]
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "partition": {
          "$ref": "#/$defs/id"
        },
        "ownership": {
          "$ref": "#/$defs/id"
        },
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "captureBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "archive_inventory_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "component_ids",
        "contract",
        "sha256",
        "result",
        "payload"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/id"
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contract": {
          "$ref": "#/$defs/evidenceContract"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "INFO",
            "SKIPPED",
            "NOT_APPLICABLE"
          ]
        },
        "payload": {
          "description": "Opaque evidence payload governed by the versioned evidence contract; adapter-envelope fields remain closed.",
          "type": "object",
          "minProperties": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "component_assertion"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "const": "INFO"
              },
              "payload": {
                "$ref": "#/$defs/componentAssertionPayload"
              }
            }
          }
        }
      ]
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "android-patch-capture-evidence",
            "android-patch-capture-component-assertion"
          ]
        },
        "version": {
          "const": "2.1"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "componentAssertionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "result",
        "component_ids",
        "assertions"
      ],
      "properties": {
        "kind": {
          "const": "component_assertion"
        },
        "result": {
          "const": "INFO"
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/componentAssertionResult"
              },
              {
                "$ref": "#/$defs/componentAssertionNotApplicable"
              }
            ]
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "componentAssertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "assertion_id",
        "result",
        "observations"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/id"
        },
        "assertion_id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "INFO"
          ]
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "componentAssertionNotApplicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "assertion_id",
        "result",
        "basis",
        "limits"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/id"
        },
        "assertion_id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "const": "NOT_APPLICABLE"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
