{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "akbs-incoming-public-contract-v1",
  "contract": "akbs-incoming-v1",
  "schema_version": "1",
  "manifest_schema": {
    "path": "knowledge-incoming-package.schema.json",
    "id": "https://akbs.internal/contracts/incoming/v1/knowledge-incoming-package.schema.json",
    "sha256": "65472e6fea5ebad7a0bc6f548986156d3c8135d4a903ea5f1d932b058bb198e2"
  },
  "golden_fixtures": {
    "daily": {
      "path": "fixtures/daily.manifest.json",
      "package_kind": "daily_trace",
      "sha256": "b907189009b81dcc8874f19b472076ece943901be4d1afb53f9290ca18e588a6"
    },
    "weekly": {
      "path": "fixtures/weekly.manifest.json",
      "package_kind": "weekly_trace",
      "sha256": "980abda97a2ceaab54a13e7a6d3549846a0bf607612c3bba33e9b679ce03d4a3"
    },
    "patch": {
      "path": "fixtures/patch.manifest.json",
      "package_kind": "framework_change",
      "sha256": "0ee8eb63a8be866ea4a2e7053870f1e21a357db20caeb6848e860db9bc544bd9"
    }
  },
  "server_validator": "akbs_active/upload_domains/incoming_contract.py",
  "success_reason_codes": [
    "server_contract_v1_pass"
  ],
  "reason_code_families": {
    "archive": [
      "archive_compressed_bytes_exceeded",
      "archive_compression_ratio_exceeded",
      "archive_duplicate_path",
      "archive_empty_payload",
      "archive_file_count_exceeded",
      "archive_invalid_format",
      "archive_missing_manifest",
      "archive_single_file_bytes_exceeded",
      "archive_total_bytes_exceeded",
      "archive_unreadable_entry",
      "archive_unsafe_path",
      "archive_unsupported_entry"
    ],
    "identity": [
      "invalid_date",
      "invalid_run_id",
      "member_mismatch",
      "missing_required_field",
      "package_already_exists",
      "package_identity_mismatch",
      "route_kind_mismatch",
      "unsupported_schema",
      "unsupported_schema_version"
    ],
    "references": [
      "duplicate_evidence_kind",
      "files_not_object",
      "invalid_file_list",
      "invalid_json_file",
      "missing_evidence_kind",
      "missing_file_reference",
      "missing_referenced_file",
      "missing_required_evidence"
    ],
    "report": [
      "display_date_mismatch",
      "display_member_mismatch",
      "invalid_report_evidence",
      "invalid_report_path",
      "invalid_report_view",
      "missing_report_view",
      "missing_week_range",
      "project_trace_mismatch",
      "report_type_mismatch"
    ],
    "framework": [
      "ai_trace_mismatch",
      "case_binding_mismatch",
      "display_trace_mismatch",
      "invalid_patch_ai_facts",
      "invalid_patch_asset",
      "invalid_patch_view",
      "missing_patch_view",
      "package_status_not_validated",
      "patch_asset_trace_mismatch",
      "variant_binding_mismatch",
      "variant_status_mismatch",
      "variant_trace_mismatch",
      "verification_method_missing",
      "verification_not_pass"
    ],
    "patch_queue": [
      "envelope_revision_missing",
      "idempotency_conflict",
      "idempotency_key_missing",
      "information_attachment_duplicate",
      "information_attachment_hash_mismatch",
      "information_attachment_integrity",
      "information_attachment_invalid",
      "information_attachment_not_found",
      "information_attachment_path_invalid",
      "information_attachment_size",
      "information_attachments_invalid",
      "information_attachments_too_large",
      "information_completion_empty",
      "information_field_value_invalid",
      "information_fields_invalid",
      "information_fields_unsupported",
      "information_request_closed",
      "information_request_incomplete",
      "information_request_member_mismatch",
      "information_request_not_found",
      "information_request_open",
      "patch_asset_immutable",
      "patch_package_head_missing",
      "patch_package_contract_unavailable",
      "patch_package_not_found",
      "patch_package_not_in_queue",
      "patch_set_changed",
      "patch_set_missing",
      "patch_set_proof_mismatch",
      "queue_state_closed",
      "queue_state_not_reviewable"
    ]
  },
  "duplicate_package_identity": {
    "content_identity": "akbs-directory-payload-sha256-v1",
    "same_file_tree_sha256": {
      "http_status": 200,
      "outcome": "idempotent_replay",
      "creates_new_fact": false
    },
    "different_file_tree_sha256": {
      "http_status": 409,
      "outcome": "reject_conflict",
      "reason_code": "package_already_exists",
      "creates_new_fact": false
    }
  },
  "patch_information_completion": {
    "schema": "akbs-patch-package-information-completion/v1",
    "fields": [
      {"id": "project", "label": "项目"},
      {"id": "projects", "label": "适用项目"},
      {"id": "platform", "label": "平台"},
      {"id": "android_version", "label": "Android 版本"},
      {"id": "title", "label": "标题"},
      {"id": "summary", "label": "功能说明"},
      {"id": "feature_name", "label": "功能名称"},
      {"id": "problem", "label": "问题说明"},
      {"id": "solution", "label": "解决办法"},
      {"id": "result", "label": "验证结果"},
      {"id": "risk_or_gap", "label": "风险或边界"},
      {"id": "code_anchors", "label": "代码位置"},
      {"id": "verification", "label": "验证说明"},
      {"id": "applicability", "label": "适用边界"}
    ],
    "attachment": {
      "max_file_bytes": 2097152,
      "max_total_bytes": 8388608,
      "patch_assets_immutable": true
    }
  },
  "patch_package_contract": {
    "schema": "akbs-patch-package-contract/v1",
    "business_identity": {
      "visible_package_type": "patch_package",
      "queue_identity": "patch_package_heads.package_key",
      "main_branch_identity": "curation_units.unit_id",
      "patch_assets_immutable": true,
      "non_patch_envelope_append_only": true
    },
    "patch_set": {
      "algorithm": "sha256-canonical-json-v1",
      "source": "package_assets[asset_type=patch]",
      "sort": ["relative_path", "sha256"],
      "fields": ["relative_path", "sha256", "size_bytes"]
    },
    "queue": {
      "states": [
        "received",
        "information_requested",
        "information_submitted",
        "admitted",
        "rejected"
      ],
      "transitions": [
        {"from": "received", "action": "request_information", "to": "information_requested"},
        {"from": "information_submitted", "action": "request_information", "to": "information_requested"},
        {"from": "information_requested", "action": "complete_information", "to": "information_submitted"},
        {"from": "received", "action": "admit", "to": "admitted"},
        {"from": "information_submitted", "action": "admit", "to": "admitted"},
        {"from": "received", "action": "reject", "to": "rejected"},
        {"from": "information_requested", "action": "reject", "to": "rejected"},
        {"from": "information_submitted", "action": "reject", "to": "rejected"}
      ],
      "terminal_states": ["admitted", "rejected"],
      "idempotency": "same-actor-and-key-replays-only-identical-canonical-payload"
    },
    "curation": {
      "allowed_decisions": ["new_case", "merge_existing"],
      "member_actions": ["confirm_merge", "submit_merge_dispute"],
      "forbidden_decisions": ["needs_evidence", "supplement_review"],
      "forbidden_actions": [
        "submit_supplement",
        "close_supplement_chain",
        "upload_replacement_original"
      ]
    },
    "retired_business_fields": [
      "logical_package_key",
      "logical_root_package_key",
      "original_package_key",
      "root_original_package_key",
      "supplement_delta",
      "supplement_for",
      "supplement_for_package_key",
      "supplement_intent",
      "supplement_mode",
      "supplement_package_key",
      "supplement_reason",
      "supplement_task"
    ],
    "retired_business_values": [
      "original_package",
      "supplement_package",
      "logical_package",
      "needs_evidence",
      "supplement_review",
      "close_supplement_chain"
    ],
    "history": {
      "raw_rows": "immutable_audit_only",
      "public_source_roles": ["source"],
      "missing_parent_projection": "history_compatible_patch_package",
      "inferred_relation_requires_audit_marker": true
    },
    "regenerate_when": [
      "patch_bytes_change",
      "patch_path_change",
      "patch_set_change",
      "functional_split_required"
    ]
  }
}
