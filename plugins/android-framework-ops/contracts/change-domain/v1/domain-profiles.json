{
  "schema": "android-change-domain-profiles-v1",
  "domain_field": "change_domain",
  "selection_semantics": "primary_ownership_build_and_verification_surface",
  "cross_domain_components_allowed": true,
  "weak_title_or_filename_inference_forbidden": true,
  "domains": {
    "framework": {
      "layer_group": "platform_runtime",
      "typical_owners": ["frameworks/base", "system_server", "framework_services"],
      "required_evidence": ["platform_build", "runtime_behavior", "regression", "rollback"],
      "production_submission": "incoming_v1_framework_change"
    },
    "system_app": {
      "layer_group": "application",
      "typical_owners": ["SystemUI", "Launcher", "Settings", "privileged_system_app"],
      "required_evidence": ["platform_app_build", "permission_signing", "integration_behavior", "rollback"],
      "production_submission": "capability_gated"
    },
    "app": {
      "layer_group": "application",
      "typical_owners": ["gradle_application", "non_privileged_application"],
      "required_evidence": ["variant_build", "manifest", "unit_or_ui_test", "install_upgrade", "rollback"],
      "production_submission": "capability_gated"
    },
    "hal": {
      "layer_group": "native_vendor_boundary",
      "typical_owners": ["aidl_hal", "hidl_hal", "vendor_service_interface"],
      "required_evidence": ["interface_version", "vintf", "selinux", "service_registration", "hardware_behavior", "rollback"],
      "production_submission": "capability_gated"
    },
    "native": {
      "layer_group": "native_vendor_boundary",
      "typical_owners": ["native_service", "native_library", "system_native"],
      "required_evidence": ["soong_build", "abi_api", "linker_boundary", "native_runtime", "rollback"],
      "production_submission": "capability_gated"
    },
    "vendor": {
      "layer_group": "native_vendor_boundary",
      "typical_owners": ["vendor_bsp", "proprietary_integration", "product_partition_integration"],
      "required_evidence": ["owner_build", "partition_boundary", "compatibility", "device_behavior", "rollback"],
      "production_submission": "capability_gated"
    },
    "kernel": {
      "layer_group": "kernel_board",
      "typical_owners": ["kernel_core", "kernel_subsystem"],
      "required_evidence": ["kconfig_makefile", "kernel_or_module_build", "boot", "dmesg", "regression", "rollback"],
      "production_submission": "capability_gated"
    },
    "driver": {
      "layer_group": "kernel_board",
      "typical_owners": ["device_driver", "vendor_kernel_module", "firmware_integration"],
      "required_evidence": ["probe_bind", "power_suspend", "device_io", "module_or_image_build", "hardware_behavior", "rollback"],
      "production_submission": "capability_gated"
    },
    "device": {
      "layer_group": "kernel_board",
      "typical_owners": ["device_product_config", "dts_dtbo", "board_overlay", "boot_partition_integration"],
      "required_evidence": ["board_build", "boot_integration", "device_behavior", "partition_or_overlay", "rollback"],
      "production_submission": "capability_gated"
    },
    "build": {
      "layer_group": "build_release",
      "typical_owners": ["soong", "make", "gradle", "release_integration"],
      "required_evidence": ["dependency_graph", "clean_incremental", "reproducibility", "artifact_contract", "rollback"],
      "production_submission": "capability_gated"
    }
  }
}
