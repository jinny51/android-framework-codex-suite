{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:android-patch-capture-package:v2.1",
  "title": "Standalone Android patch capture package manifest v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "package_type",
    "components",
    "primary_component_id",
    "change_id",
    "readme",
    "project",
    "platform_token",
    "platform",
    "android_version",
    "summary",
    "status",
    "declared_status",
    "effective_status",
    "status_was_upgraded",
    "implementation_origin",
    "workflow_contract",
    "captured_by",
    "authority",
    "server_submission",
    "coding_standard_check",
    "created_at",
    "related_report_run_ids",
    "source_roots",
    "git_repositories",
    "project_inference",
    "verification_chain",
    "patches",
    "evidence",
    "qualification_bindings",
    "file_inventory"
  ],
  "properties": {
    "schema": {
      "const": "android-patch-capture-package-v2"
    },
    "schema_version": {
      "const": "2.1"
    },
    "package_type": {
      "const": "android_change_capture"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "primary_component_id": {
      "$ref": "#/$defs/id"
    },
    "component": {
      "$ref": "#/$defs/componentFacets"
    },
    "compatibility_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_change_domain"
      ],
      "properties": {
        "legacy_change_domain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "change_id": {
      "$ref": "#/$defs/id"
    },
    "readme": {
      "const": "README.md"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "platform_token": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "android_version": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "declared_status": {
      "$ref": "#/$defs/status"
    },
    "effective_status": {
      "$ref": "#/$defs/status"
    },
    "status_was_upgraded": {
      "const": false
    },
    "implementation_origin": {
      "enum": [
        "codex",
        "manual",
        "external",
        "historical",
        "mixed",
        "unknown"
      ]
    },
    "workflow_contract": {
      "enum": [
        "current_codex_skill",
        "manual_import",
        "historical_import"
      ]
    },
    "captured_by": {
      "const": "codex"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "local_capture_only",
        "can_confirm_or_downgrade_status_only",
        "can_upload",
        "can_allocate_server_package_id",
        "can_materialize_knowledge"
      ],
      "properties": {
        "owner": {
          "const": "android-patch-capture"
        },
        "local_capture_only": {
          "const": true
        },
        "can_confirm_or_downgrade_status_only": {
          "const": true
        },
        "can_upload": {
          "const": false
        },
        "can_allocate_server_package_id": {
          "const": false
        },
        "can_materialize_knowledge": {
          "const": false
        }
      }
    },
    "server_submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v2_writer",
        "v2_submission_allowed",
        "server_qualified",
        "note"
      ],
      "properties": {
        "v2_writer": {
          "const": "disabled"
        },
        "v2_submission_allowed": {
          "const": false
        },
        "server_qualified": {
          "const": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coding_standard_check": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "related_report_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "git_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "project_inference": {
      "type": "object"
    },
    "verification_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_build",
        "local_delivery",
        "device_verification"
      ],
      "properties": {
        "remote_build": {
          "type": "boolean"
        },
        "local_delivery": {
          "type": "boolean"
        },
        "device_verification": {
          "type": "boolean"
        }
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "qualification_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/qualification"
      }
    },
    "source_snapshot": {
      "type": "object"
    },
    "file_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "scope",
        "manifest_self_hash_excluded",
        "files"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "scope": {
          "const": "all_regular_package_files_except_manifest.json"
        },
        "manifest_self_hash_excluded": {
          "const": true
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "validated",
        "failed",
        "blocked"
      ]
    },
    "componentFacets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "type",
        "partition",
        "ownership"
      ],
      "properties": {
        "layer": {
          "enum": [
            "application",
            "platform",
            "native",
            "hal",
            "kernel",
            "device",
            "build"
          ]
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "partition": {
          "$ref": "#/$defs/id"
        },
        "ownership": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "type",
        "partition",
        "ownership"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "layer": {
          "enum": [
            "application",
            "platform",
            "native",
            "hal",
            "kernel",
            "device",
            "build"
          ]
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "partition": {
          "$ref": "#/$defs/id"
        },
        "ownership": {
          "$ref": "#/$defs/id"
        },
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repo_path",
        "root",
        "component_ids",
        "git"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "repo_path": {
          "$ref": "#/$defs/path"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "git": {
          "type": "object"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "repository_id",
        "repo_path",
        "component_ids",
        "source_root",
        "content_sha1",
        "status",
        "reuse_hint",
        "project",
        "platform_token",
        "platform",
        "android_version",
        "implementation_origin",
        "workflow_contract",
        "captured_by",
        "facts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactId"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "repository_id": {
          "$ref": "#/$defs/id"
        },
        "repo_path": {
          "$ref": "#/$defs/path"
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        },
        "content_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "reuse_hint": {
          "type": "boolean"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "platform_token": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "android_version": {
          "type": "string",
          "minLength": 1
        },
        "implementation_origin": {
          "enum": [
            "codex",
            "manual",
            "external",
            "historical",
            "mixed",
            "unknown"
          ]
        },
        "component": {
          "$ref": "#/$defs/componentFacets"
        },
        "compatibility_route": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_change_domain"
          ],
          "properties": {
            "legacy_change_domain": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "workflow_contract": {
          "enum": [
            "current_codex_skill",
            "manual_import",
            "historical_import"
          ]
        },
        "captured_by": {
          "const": "codex"
        },
        "facts": {
          "type": "object"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "result",
        "summary",
        "component_ids",
        "contract",
        "declared_claims"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "INFO",
            "SKIPPED",
            "NOT_APPLICABLE"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contract": {
          "$ref": "#/$defs/evidenceContract"
        },
        "declared_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "not_applicable_basis": {
          "$ref": "#/$defs/notApplicableBasis"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "NOT_APPLICABLE"
              }
            }
          },
          "then": {
            "required": [
              "not_applicable_basis"
            ]
          },
          "else": {
            "not": {
              "required": [
                "not_applicable_basis"
              ]
            }
          }
        }
      ]
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "repository_ids",
        "patch_ids",
        "evidence_ids",
        "contract",
        "declared_claims"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/id"
        },
        "repository_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "patch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactId"
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contract": {
          "const": "android-patch-capture-local-qualification-v2"
        },
        "declared_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,255}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "notApplicableBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "limits"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limits": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
