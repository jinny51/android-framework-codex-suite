{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akbs.internal/contracts/incoming/v2/client-adapter-outputs.schema.json",
  "title": "AKBS Android change client adapter outputs v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "source_package_key",
    "qualification_input_sha256",
    "profile_id",
    "profile_artifact_sha256",
    "declared_package_status",
    "components"
  ],
  "properties": {
    "schema": {"const": "akbs-client-adapter-outputs-v1"},
    "authority": {"const": "untrusted_client_input"},
    "source_package_key": {
      "type": "string",
      "pattern": "^[0-9]{8}/[a-z0-9][a-z0-9._-]{1,63}/[0-9]{8}-[0-9]{6}(?:-[A-Za-z0-9_.-]+)?$"
    },
    "qualification_input_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"const": "akbs-component-evidence-profiles-v1"},
    "profile_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "declared_package_status": {"const": "validated"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/componentOutputs"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notApplicableBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "limits"],
      "properties": {
        "basis": {"type": "string", "minLength": 1, "maxLength": 2000},
        "limits": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "adapterOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "component_id",
        "group_id",
        "source_evidence_id",
        "source_evidence_sha256",
        "adapter_contract",
        "adapter_version",
        "claim",
        "adapter_result"
      ],
      "properties": {
        "schema": {"const": "akbs-client-adapter-output-v1"},
        "component_id": {"$ref": "#/$defs/id"},
        "group_id": {"$ref": "#/$defs/token"},
        "source_evidence_id": {"$ref": "#/$defs/id"},
        "source_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_contract": {"$ref": "#/$defs/token"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "claim": {"$ref": "#/$defs/token"},
        "adapter_result": {"enum": ["PASS", "INFO", "NOT_APPLICABLE"]},
        "not_applicable_basis": {"$ref": "#/$defs/notApplicableBasis"}
      },
      "allOf": [
        {
          "if": {"properties": {"adapter_result": {"const": "NOT_APPLICABLE"}}},
          "then": {"required": ["not_applicable_basis"]},
          "else": {"not": {"required": ["not_applicable_basis"]}}
        }
      ]
    },
    "componentOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "outputs"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/adapterOutput"}
        }
      }
    }
  }
}
