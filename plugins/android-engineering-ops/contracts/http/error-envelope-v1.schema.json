{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akbs.internal/contracts/http/error-envelope-v1.schema.json",
  "title": "AKBS HTTP error envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "message", "request_id"],
  "properties": {
    "schema": {"const": "akbs-error-envelope-v1"},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "message": {"type": "string", "minLength": 1, "maxLength": 240},
    "request_id": {"type": "string", "pattern": "^req_[0-9a-f]{32}$"},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "details": {"type": "object"},
    "detail": {"type": "string", "maxLength": 512}
  }
}
