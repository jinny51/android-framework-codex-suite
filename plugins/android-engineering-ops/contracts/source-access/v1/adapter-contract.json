{
  "schema": "android-source-access-adapter-v1",
  "intent": "android-source-access",
  "implementation_owner": "android-engineering-ops",
  "core_public_skill": true,
  "public_entry_plugins": {
    "wsl": "android-engineering-ops",
    "macos": "android-engineering-ops"
  },
  "host_detection": {
    "automatic": true,
    "supported_hosts": [
      "wsl",
      "macos"
    ],
    "unsupported_host_behavior": "fail_closed_without_running_an_adapter"
  },
  "adapters": {
    "wsl": {
      "root": "adapters/source-access/wsl",
      "transport": "cifs",
      "credential_store": "wsl_private_state",
      "public_entry_plugin": "android-engineering-ops"
    },
    "macos": {
      "root": "adapters/source-access/macos",
      "transport": "smbfs",
      "credential_store": "macos_keychain",
      "public_entry_plugin": "android-engineering-ops"
    }
  },
  "shared_invariants": [
    "remote_source_identity_comes_from_android_remote_channel",
    "mounted_source_is_for_human_crud_and_artifact_bridge_only",
    "codex_never_reads_or_modifies_android_source_through_the_mount",
    "project_level_mount_is_the_default",
    "registered_handoff_contains_ssh_host_remote_root_platform_and_project"
  ]
}
