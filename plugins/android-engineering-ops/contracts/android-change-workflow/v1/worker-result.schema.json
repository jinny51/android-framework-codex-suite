{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:worker-result:v1",
  "title": "Android change workflow worker result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "run_id",
    "assignment_id",
    "assignment_sha256",
    "attempt",
    "worker_binding",
    "started_at",
    "completed_at",
    "outcome",
    "observed_workspaces",
    "reported_changes",
    "commands",
    "checks",
    "evidence",
    "reported_scope_deviations",
    "summary"
  ],
  "properties": {
    "schema": {"const": "worker-result-v1"},
    "result_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "assignment_id": {"$ref": "#/$defs/id"},
    "assignment_sha256": {"$ref": "#/$defs/sha256"},
    "attempt": {"type": "integer", "minimum": 1},
    "worker_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_task_id", "worker_profile_id"],
      "properties": {
        "worker_task_id": {"$ref": "#/$defs/id"},
        "worker_profile_id": {"$ref": "#/$defs/id"}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["completed", "partial", "blocked", "failed"]},
    "observed_workspaces": {"type": "array", "items": {"$ref": "#/$defs/observedWorkspace"}},
    "reported_changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "reported_scope_deviations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "completed"}}},
      "then": {
        "properties": {
          "checks": {"minItems": 1},
          "evidence": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.git(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "observedWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "workspace_id", "base_revision", "start_head", "end_head"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/id"},
        "base_revision": {"$ref": "#/$defs/gitOid"},
        "start_head": {"$ref": "#/$defs/gitOid"},
        "end_head": {"$ref": "#/$defs/gitOid"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "operation", "path", "before_sha256", "after_sha256"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/id"},
        "operation": {"enum": ["add", "modify", "delete", "rename"]},
        "path": {"$ref": "#/$defs/path"},
        "rename_from": {"$ref": "#/$defs/path"},
        "before_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "after_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "rename"}}},
          "then": {"required": ["rename_from"]},
          "else": {"not": {"required": ["rename_from"]}}
        },
        {
          "if": {"properties": {"operation": {"const": "add"}}},
          "then": {"properties": {"before_sha256": {"type": "null"}, "after_sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "delete"}}},
          "then": {"properties": {"before_sha256": {"$ref": "#/$defs/sha256"}, "after_sha256": {"type": "null"}}}
        },
        {
          "if": {"properties": {"operation": {"enum": ["modify", "rename"]}}},
          "then": {"properties": {"before_sha256": {"$ref": "#/$defs/sha256"}, "after_sha256": {"$ref": "#/$defs/sha256"}}}
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "request_sha256", "receipt_sha256", "exit_code"],
      "properties": {
        "command_id": {"$ref": "#/$defs/id"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "exit_code": {"type": "integer"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "receipt_sha256"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["passed", "failed", "not_run"]},
        "receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not_run"}}},
          "then": {"properties": {"receipt_sha256": {"type": "null"}}},
          "else": {"properties": {"receipt_sha256": {"$ref": "#/$defs/sha256"}}}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "uri", "sha256", "size_bytes"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/id"},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
