{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:android-practices-provider:v1",
  "title": "Android practices provider v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_id",
    "provider_version",
    "compatible_core_contracts",
    "capabilities",
    "fallback",
    "authority"
  ],
  "properties": {
    "schema": {"const": "android-practices-provider-v1"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-android-practices$"},
    "provider_version": {"$ref": "#/$defs/semver"},
    "compatible_core_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "contains": {"const": "android-engineering-ops-v1"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "coding": {"$ref": "#/$defs/codingCapability"},
        "execution": {"$ref": "#/$defs/executionCapability"}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_absent",
        "applicability_miss",
        "provider_missing_or_invalid",
        "declared_capability_broken",
        "invalid_decision"
      ],
      "properties": {
        "capability_absent": {"const": "core"},
        "applicability_miss": {"const": "core"},
        "provider_missing_or_invalid": {"const": "fail_closed"},
        "declared_capability_broken": {"const": "fail_closed"},
        "invalid_decision": {"const": "fail_closed"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_only",
        "can_spawn",
        "can_write_source",
        "can_acquire_lock",
        "can_execute_side_effects",
        "can_upload",
        "can_accept_gate",
        "can_final_accept"
      ],
      "properties": {
        "decision_only": {"const": true},
        "can_spawn": {"const": false},
        "can_write_source": {"const": false},
        "can_acquire_lock": {"const": false},
        "can_execute_side_effects": {"const": false},
        "can_upload": {"const": false},
        "can_accept_gate": {"const": false},
        "can_final_accept": {"const": false}
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "skillId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layer": {"enum": ["application", "platform", "native", "hal", "kernel", "device", "build"]},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_actions", "component_layers"],
      "properties": {
        "workflow_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "component_layers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/layer"}}
      }
    },
    "baseCapability": {
      "type": "object",
      "required": ["contract", "skill_id", "skill_version", "skill_sha256", "agent_metadata_sha256", "decision_entrypoint_path", "decision_entrypoint_sha256", "decision_schema", "applicability"],
      "properties": {
        "contract": {"type": "string", "minLength": 1},
        "skill_id": {"$ref": "#/$defs/skillId"},
        "skill_version": {"$ref": "#/$defs/semver"},
        "skill_sha256": {"$ref": "#/$defs/sha256"},
        "agent_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "decision_entrypoint_path": {"type": "string", "pattern": "^skills/[a-z0-9][a-z0-9-]*/scripts/[A-Za-z0-9][A-Za-z0-9._-]*\\.py$"},
        "decision_entrypoint_sha256": {"$ref": "#/$defs/sha256"},
        "decision_schema": {"type": "string", "minLength": 1},
        "applicability": {"$ref": "#/$defs/applicability"}
      }
    },
    "codingCapability": {
      "allOf": [
        {"$ref": "#/$defs/baseCapability"},
        {
          "type": "object",
          "properties": {
            "contract": {"const": "android-coding-policy-provider-v1"},
            "decision_schema": {"const": "coding-policy-decision-v1"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "executionCapability": {
      "allOf": [
        {"$ref": "#/$defs/baseCapability"},
        {
          "type": "object",
          "required": ["worker_profiles"],
          "properties": {
            "contract": {"const": "android-execution-policy-provider-v1"},
            "decision_schema": {"const": "execution-policy-decision-v1"},
            "worker_profiles": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
              "additionalProperties": {"$ref": "#/$defs/workerProfile"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "workerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch", "task_classes", "effect_ceiling"],
      "properties": {
        "dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "reasoning_effort"],
          "properties": {
            "model_id": {"type": "string", "minLength": 1},
            "reasoning_effort": {"type": "string", "minLength": 1}
          }
        },
        "task_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["analysis", "diagnosis", "implementation", "review", "verification", "bounded_operation"]}
        },
        "effect_ceiling": {"enum": ["read_only", "workspace_mutation", "controlled_operation"]}
      }
    }
  }
}
